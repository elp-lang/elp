// The safe surface over internal/external.elp. This is where the FFI boundary's
// questions turn into decisions a caller lives with.

import { Error } from elp.types
import {
	Sqlite3,
	CString,
	sqlite3_open,
	sqlite3_close,
	sqlite3_errmsg,
	sqlite3_threadsafe,
} from .internal.external
import { Statement } from .internal.statement

@error
export enum DbError {
	CANNOT_OPEN { path string, message string },
	CLOSED,
	NOT_THREADSAFE { mode int },
}

// A connection.
//
// This is the FFI counterpart of `examples/Sheet`'s `Style` and
// `examples/Pipeline`'s `Collector`: a domain type wrapping a handle whose
// duplicates alias. The difference is that for those two the compiler could
// see it, because `Confined<T>`/`Synchronized<T>` are elp types. Here it
// cannot, and the declaration is the only record.
export object Connection {
	// RESOLVED, and the first draft of this file got the diagnosis wrong.
	//
	// It held this field as `&Sqlite3` and said field-wise `Copy` "cannot
	// tell" because an external type has no fields to be wise about. The
	// rule was not failing to see the handle: `memory-model.md` Finding 6
	// makes `&T` unconditionally `Copy`, so field-wise looked at
	// `&Sqlite3`, applied a decided rule, and said *yes*. This object was
	// `Copy`-eligible, and `Connection implements Move` was the author
	// declining a `Copy` the compiler would have granted — with nothing
	// stopping the next person granting it.
	//
	// The handle is a value, not a borrow. Nothing in the program owns a
	// `Sqlite3` for a borrow to borrow from: SQLite owns the pointee, elp
	// owns the pointer. `aliasing.md` now forbids a borrow in a field for
	// exactly this reason, and these two files held the only `&` fields in
	// the whole corpus.
	const handle Sqlite3,
	const path   string,
}

// A conclusion now, not a promise. `Sqlite3 implements Move` is declared at
// the boundary (internal/external.elp), this object holds one, and field-wise
// `Copy` forces the rest — the same way `Style implements Move` follows from
// holding a `Confined<StyleValues>` in `examples/Sheet`.
//
// There is deliberately no `.alias()`. SQLite permits several connections to
// one file and that is the supported way to share — `Connection.open` twice
// — rather than two handles to one connection, which would make "who closes
// it" unanswerable.
Connection implements Move

// GAP 1, RESOLVED — nothing guaranteed `close` was called, and now `with`
// does.
//
// `Move` gives *at most once*: once the handle is moved into `close` the
// source is dead, so a double close is a compile error. It never gave *at
// least once*, and a program that dropped a `Connection` leaked the C
// allocation with nothing to notice.
//
// Three candidates were on the table: a `Drop`-shaped interface, which
// reaches well past FFI and needs liveness tracking on every path;
// `@MustUse`-style linting, which catches the common case and nothing else;
// and the scoped form, which won.
//
//   with Connection.open(path)? as db {
//       db.prepare("select 1")
//   }
//
// `memory-model.md` records why it is affordable: release is tied to a brace
// in the source rather than to a value's lifetime, so there are no drop
// flags, no moved-out analysis and no drop glue — a value not bound by a
// `with` is simply never released. `examples/VulkanTriangle` is what made it
// urgent, because its five-deep handle tree needs release *ordering* and
// reverse-order release gives that for free.
export fn Connection.open(path string) -> Either<Self, Error> {
	// GAP 2, RESOLVED — there is no `unsafe` marker, because `@external` is
	// the marker.
	//
	// An earlier draft of this probe asked whether `unsafe` goes on the
	// declaration, the call site, or a block. The question dissolves:
	// `@external` is an attribute on the declaration, it is the only way to
	// reach native code, and `links` in `Package.elp` bounds what it can
	// reach. There is nothing a second keyword would add.
	//
	// What remains true is the objection to declaration-site marking: a
	// reader of *this* function cannot see that it touches native code. The
	// mitigation is that `links` lists the whole surface in one file, which
	// is a better audit point than a keyword sprinkled through bodies.
	const c = CString.from(path)

	// The out-parameter, with nothing invented. An earlier draft wrote
	// `&out` against an undeclared `out` binding; `memory-model.md` Finding 4
	// settles it as `&Optional<T>` — a slot that may be empty, which is the
	// actual difficulty rather than mutability direction.
	var handle Optional<Sqlite3> = null

	match sqlite3_open(&c, &handle) {
		0    -> {}
		code -> throw DbError.CANNOT_OPEN { path, message = "sqlite error {code}" }
	}

	// GAP — the status code said the slot was written and the type cannot
	// know that. Two returns the C ABI does not relate, so this `??` is the
	// irreducible residual rather than a missing feature.
	match handle {
		null -> throw DbError.CANNOT_OPEN { path, message = "sqlite reported success and wrote nothing" }
		h    -> return Ok(Self { handle = h, path })
	}
}

// `Scoped` is what `with` calls at every exit from a block, so GAP 1 below
// is answered: a `Connection` acquired by a `with` is released on every path
// out of it, including the error paths.
Connection implements Scoped

export fn Connection.release(self) {
	// GAP — `release` returns nothing and `sqlite3_close` returns a status,
	// so a failing close is silently dropped. That is Rust's problem with
	// `Drop` too, and it is why `close` below still exists returning
	// `Either`. Whether both may coexist, and which one `with` calls, is the
	// open question in `memory-model.md`'s scoped-release section.
	sqlite3_close(self.handle)
}

export fn Connection.close(self) -> Either<bool, Error> {
	// `self` by value, not `&self` — this consumes the connection, which is
	// what makes the double close a compile error rather than a crash.
	//
	// GAP — `fn Type.method(self)` is not a form `functions.md` has.
	// Receivers there are `&self` or `&var self`. A by-value receiver is
	// exactly what a consuming method needs and there is no spelling for it —
	// and `Scoped.release(self)` above is now the second, harder witness,
	// because `with` cannot be built without it.
	match sqlite3_close(self.handle) {
		0    -> return Ok(true)
		code -> throw DbError.CANNOT_OPEN { path = self.path, message = "close failed: {code}" }
	}
}

export fn Connection.lastError(&self) -> string {
	return sqlite3_errmsg(self.handle).asString() ?? "unknown"
}

export fn Connection.prepare(&self, sql string) -> Either<Statement, Error> {
	return Statement.new(self.handle, sql)
}

// GAP 3 — the thread discipline is a runtime answer to a static question.
//
// `aliasing.md` puts every mutable alias in one of two tiers: `Confined<T>`
// (never crosses a thread) or `Synchronized<T>` (crosses, lock in the type).
// A `Connection` is one or the other depending on how libsqlite3 was built,
// and `sqlite3_threadsafe()` is the only way to find out.
//
// So this function has to exist, and it returns an answer the type system
// needed before the program started:
//
//   0  single-thread    the whole library is unsafe to share at all
//   1  serialized       connections may be shared freely
//   2  multi-thread     one connection per thread, no sharing
//
// Mapping those onto elp: mode 1 is `Synchronized`-shaped, mode 2 is
// `Confined`-shaped, mode 0 is neither. A `Connection` cannot be declared
// `Sendable` or not until this is known, which means either the binding
// declares the strictest and throws away mode 1's capability, or
// `Sendable`-ness becomes something checked at startup — which is a
// different language from the one `reactivity.md` describes.
//
// This is the first thing in the corpus that `aliasing.md` cannot answer
// even in principle.
export fn Connection.threadingMode() -> int {
	return sqlite3_threadsafe()
}

// vim: ft=kotlin
