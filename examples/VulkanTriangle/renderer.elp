// The ownership tree. This is the file that exists to be looked at: five
// handles, four of them owned, created in one order and destroyed in the
// reverse order, with nothing in the language saying so.

// `Buffer<T>` is imported, not atmospheric: it fails `name-resolution.md`'s
// criterion because no grammar or desugaring produces one.
import { Buffer } from elp.memory
import { Window } from .window
import {
	VkInstance,
	VkPhysicalDevice,
	VkDevice,
	VkQueue,
	VkSurfaceKHR,
	VkSwapchainKHR,
	VkCommandPool,
	OpaqueHandle,
	vkCreateInstance,
	vkDestroyInstance,
	vkEnumeratePhysicalDevices,
	vkCreateDevice,
	vkDestroyDevice,
	vkGetDeviceQueue,
	vkCreateSwapchainKHR,
	vkDestroySwapchainKHR,
	vkCreateCommandPool,
	vkDestroyCommandPool,
	vkQueueSubmit,
	vkQueuePresentKHR,
	vkDeviceWaitIdle,
} from .internal.vulkan
import { VkInstanceCreateInfo, StructureType } from .internal.vk-types
import { glfwCreateWindowSurface } from .internal.glfw

// MIGRATED — `@message` per variant (`macros.md`). Before this round
// `@error` generated a conformance and nothing said what `toString()`
// returned, so the best a caller could print was "NO_SWAPCHAIN". A driver
// status code is the only diagnostic Vulkan gives you and it was being
// carried in the payload and never shown.
@error
export enum RenderError {
	@message("vkCreateInstance failed: {code}")
	NO_INSTANCE { code int },

	@message("vkCreateDevice failed: {code}")
	NO_DEVICE { code int },

	@message("no Vulkan device can present to this surface")
	NO_GPU,

	@message("glfwCreateWindowSurface failed: {code}")
	NO_SURFACE { code int },

	@message("vkCreateSwapchainKHR failed: {code}")
	NO_SWAPCHAIN { code int },

	@message("frame submission failed: {code}")
	DRAW_FAILED { code int },
}

// Four owned handles and one borrowed one, in a single object, which is how
// every real renderer is written.
//
// `Renderer implements Move` is a conclusion four times over: `VkInstance`,
// `VkDevice`, `VkSurfaceKHR`, `VkSwapchainKHR` and `VkCommandPool` are all
// declared `Move` at the boundary, so field-wise forces this with no
// propagation rule — the same single rule `examples/Sheet` exercises four
// levels deep, here exercised five fields wide.
export object Renderer {
	const instance  VkInstance,
	const physical  VkPhysicalDevice,
	const device    VkDevice,
	const graphics  VkQueue,
	const surface   VkSurfaceKHR,
	const swapchain VkSwapchainKHR,
	const pool      VkCommandPool,
}

Renderer implements Move

// GAP 1 — the two `Copy` fields are the hazard and the tier is silent.
//
// `physical` and `graphics` are `Copy`, correctly: this program never
// destroys either. But `Renderer` is `Move`, so the *object* cannot be
// duplicated while two of its fields can be read out and copied anywhere —
// `renderer.graphics` is a free, unrestricted copy of a pointer that dies
// with `renderer.device`.
//
// So field-wise `Copy` protects the aggregate and not the members, and that
// asymmetry is correct for `Confined<T>` (reading one out gives you a handle
// whose cell is refcounted and still alive) and wrong here (reading one out
// gives you a pointer whose owner is a sibling field). The difference is that
// an elp handle keeps its referent alive and a foreign handle does not.
//
// This is the sharpest form of the validity gap in the corpus: not two
// objects outliving each other, but one object's field outliving another
// field of the same object.

export fn Renderer.new(window &Window) -> Either<Self, RenderError> {
	const info = VkInstanceCreateInfo {
		sType                   = StructureType.INSTANCE_CREATE_INFO.raw(),
		pNext                   = null,
		flags                   = 0,
		pApplicationInfo        = null,
		enabledLayerCount       = 0,
		ppEnabledLayerNames     = null,
		enabledExtensionCount   = 0,

		// GAP 2 — this should be GLFW's `const char**`, handed straight
		// through. See `internal/glfw.elp` GAP 1: copying it is the safe
		// move and the destination wants the pointer, so the safe move is
		// the one nobody makes. Passed `null` here, which produces an
		// instance that cannot present to a window — a deliberately broken
		// value, because writing the working version means writing the
		// unsound one.
		ppEnabledExtensionNames = null,
	}

	var instanceSlot Optional<VkInstance> = null

	match vkCreateInstance(&info, null, &var instanceSlot) {
		0    -> {}
		code -> return Err(.NO_INSTANCE { code })
	}

	// Repeated after every call below, and it is the irreducible residual
	// rather than ceremony: the status code is the only evidence the slot was
	// written, and the C ABI does not relate the two returns.
	// MIGRATED — `x ?? throw E` was the corpus's spelling for
	// unwrap-or-fail and it rested on something undesigned: `throw` as an
	// *expression* is a diverging expression, which needs a bottom type elp
	// has never specified (`error-handling.md`, "what the 36 `throw` sites
	// were really asking for"). `.orError(e)` turns an `Optional<T>` into an
	// `Either<T, E>` and `?` propagates it — two decided things.
	const instance = instanceSlot.orError(RenderError.NO_INSTANCE { code = 0 })?

	// GAP 4, RESOLVED by `errdefer` — and this file is the second program
	// to demand it, independently of the one that proposed it.
	//
	// GAP 4 used to read: *"every `throw` above this line still leaks
	// everything created before it … a failure must destroy the swapchain,
	// the device, the surface and the instance, in that order, before
	// returning — and a failure is a value that returns immediately, so
	// there is no scope exit to hook."* It then guessed that assembly
	// belongs in a `with` *"which needs a way to cancel the release, and
	// nothing proposes one."*
	//
	// `errdefer` is the answer and it dissolves the hard half rather than
	// solving it: there is nothing to cancel, because the compensation is
	// only ever registered for the error path. On success these never run
	// and the handles leave with the `Self`. LIFO like `defer`, which is
	// the reverse-acquisition order teardown needs and `release` below
	// documents by hand.
	errdefer { vkDestroyInstance(instance, null) }

	// GAP 3, RESOLVED — the count-then-fill call, now writable.
	//
	// `count` is `&Optional<int>` by `memory-model.md` Finding 4. The buffer
	// is `Buffer<Optional<VkPhysicalDevice>>`, which is the same rule at a
	// second arity: a slot that may be empty, n of them, contiguous. Every
	// element is `nil` before the call because `Buffer<T>`'s length can only
	// grow by supplying every element — so there is no uninitialised memory
	// here and no operation that asserts there isn't.
	//
	// The first call still passes `null`, which `&Buffer<...>` cannot express;
	// that is the one piece left open, and it is a signal that one C symbol is
	// two operations rather than a weakness in the storage design.
	var count Optional<int> = null
	vkEnumeratePhysicalDevices(instance, &count, null)

	const found = count ?? 0

	if found == 0 {
		return Err(.NO_GPU)
	}

	var gpus = Buffer<Optional<VkPhysicalDevice>>.filled(found, nil)
	vkEnumeratePhysicalDevices(instance, &count, &gpus)

	// Elided: ~80 lines picking a GPU with a graphics queue family that can
	// present to this surface. It is `for` over two extents and asks nothing
	// new.
	//
	// The unwrap is the same irreducible residual as `instanceSlot` above: the
	// status code is the only evidence the driver wrote this slot, and the C
	// ABI does not relate the two returns. A binding package would do it once
	// in a wrapper returning `[VkPhysicalDevice]`, which is what a wrapper is
	// for.
	const physical = gpus.at(0).orError(RenderError.NO_GPU)?

	var surfaceSlot Optional<VkSurfaceKHR> = null

	match glfwCreateWindowSurface(&instance, &window.handle, null, &var surfaceSlot) {
		0    -> {}
		code -> return Err(.NO_SURFACE { code })
	}

	const surface = surfaceSlot.orError(RenderError.NO_SURFACE { code = 0 })?

	// No `errdefer` for the surface, and the omission is a finding rather
	// than an oversight: `vkDestroySurfaceKHR` is an extension function
	// loaded by name, which `release` below records as the one handle this
	// program cannot destroy. So the error path leaks exactly what the
	// success path leaks, which is the honest state of this binding.

	var deviceSlot Optional<VkDevice> = null

	match vkCreateDevice(physical, null, null, &var deviceSlot) {
		0    -> {}
		code -> return Err(.NO_DEVICE { code })
	}

	const device = deviceSlot.orError(RenderError.NO_DEVICE { code = 0 })?
	errdefer { vkDestroyDevice(device, null) }

	// The borrowed handle. No status code at all, because nothing is created:
	// this reads a pointer out of the device. So the slot is the *only*
	// evidence here, and `??` is carrying real weight rather than satisfying
	// the type checker.
	var queueSlot Optional<VkQueue> = null
	vkGetDeviceQueue(device, 0, 0, &var queueSlot)
	const graphics = queueSlot.orError(RenderError.NO_DEVICE { code = 0 })?

	var swapchainSlot Optional<VkSwapchainKHR> = null

	match vkCreateSwapchainKHR(device, null, null, &var swapchainSlot) {
		0    -> {}
		code -> return Err(.NO_SWAPCHAIN { code })
	}

	const swapchain = swapchainSlot.orError(RenderError.NO_SWAPCHAIN { code = 0 })?
	errdefer { vkDestroySwapchainKHR(device, swapchain, null) }

	var poolSlot Optional<VkCommandPool> = null

	match vkCreateCommandPool(device, null, null, &var poolSlot) {
		0    -> {}
		code -> return Err(.NO_SWAPCHAIN { code })
	}

	// What GAP 4 leaves behind, which is smaller and still real.
	//
	// `errdefer` destroys what *this function* created. It says nothing
	// about the order relative to `release` below, and nothing enforces
	// that the four `errdefer` blocks appear in acquisition order — they
	// do, because they are written next to their acquisitions, and that is
	// a convention rather than a rule. GAP 5's point stands: the order is
	// the specification and the compiler cannot read it.
	//
	// It also does not reach a resource acquired in a *loop*: a `for` that
	// creates n command buffers and fails at item k wants n−1 releases, and
	// `errdefer` inside the loop body runs at the body's exit rather than
	// the function's. Nothing in this corpus does that yet.
	const pool = poolSlot.orError(RenderError.NO_SWAPCHAIN { code = 0 })?

	return Ok(Self {
		instance, physical, device, graphics, surface, swapchain, pool,
	})
}

export fn Renderer.drawFrame(&self) -> Either<bool, RenderError> {
	// Elided: acquire an image, record a command buffer, three draw calls.
	// `vkQueueSubmit` and `vkQueuePresentKHR` are the only part that touches
	// anything this probe is about.
	match vkQueueSubmit(self.graphics, 1, null, null) {
		0    -> {}
		code -> return Err(.DRAW_FAILED { code })
	}

	match vkQueuePresentKHR(self.graphics, null) {
		0    -> return Ok(true)
		code -> return Err(.DRAW_FAILED { code })
	}
}

Renderer implements Scoped

// Teardown, by value, in the one order that is correct.
//
// GAP 5 — this function is the specification and the compiler cannot read
// it. Reorder any two lines and the program corrupts memory or crashes in
// the driver; the types permit every permutation. `Move` guarantees each
// handle is destroyed at most once and imposes no order at all.
//
// What `Scoped` adds is that it is *called*, on every path out of the `with`
// block in `main.elp`, including the error paths. What it does not add is any
// opinion about the order of the lines inside it — reverse-order release
// orders `with` bindings relative to each other, and the five handles here
// are one binding.
//
// So the ordering gap shrinks rather than closes: across resources it is
// answered, within an aggregate it is not. The fix for the inside of this
// function is to not have an aggregate — five nested `with` bindings in
// `main.elp` instead of one `Renderer` — which is correct and gives up the
// type that makes the renderer a thing you can pass around.
export fn Renderer.release(self) {
	// Must come first: the queue may still be executing work that references
	// everything below.
	vkDeviceWaitIdle(self.device)

	vkDestroyCommandPool(self.device, self.pool, null)
	vkDestroySwapchainKHR(self.device, self.swapchain, null)
	vkDestroyDevice(self.device, null)

	// GAP 6 — the surface was created by GLFW and must be destroyed by
	// Vulkan, after the device and before the instance.
	//
	// `vkDestroySurfaceKHR` is an extension function, so by
	// `internal/vulkan.elp` GAP 3 it is only reachable through
	// `vkGetInstanceProcAddr` — which this probe cannot spell. So the surface
	// leaks, and the leak is not an oversight in this file: it is the one
	// place where two unspellable things compose.

	vkDestroyInstance(self.instance, null)

	// `self.physical` and `self.graphics` are not destroyed, because nothing
	// destroys them. They are dangling from the line above onwards, and they
	// are `Copy`, so any copy taken earlier is dangling too.
}

// vim: ft=kotlin
