// The safe surface over GLFW. This file is short on purpose: it is the one
// place in the corpus where `aliasing.md`'s owned and borrowed rows sit next
// to each other in the same file, doing different things, with the difference
// visible at a glance.

import { Error } from elp.types
import {
	GLFWwindow,
	GLFWmonitor,
	CString,
	glfwInit,
	glfwTerminate,
	glfwWindowHint,
	glfwCreateWindow,
	glfwDestroyWindow,
	glfwWindowShouldClose,
	glfwPollEvents,
	glfwGetPrimaryMonitor,
} from .internal.glfw

// The handle-less global, given a handle.
//
// `internal/glfw.elp` GAP 3 found that `glfwInit`/`glfwTerminate` are process
// state with no value for a tier to describe: initialisation must happen once
// before anything else and termination once after everything else, and the
// thing being tracked is the library itself.
//
// A token type is the whole answer, and it needed `Scoped` to be worth
// writing. `Glfw` carries no data — it exists so that "GLFW is initialised"
// is a value with a lifetime, which `with` then bounds. Terminating is its
// `release`, so it happens once, and because release order is the reverse of
// acquisition, it happens after every window acquired inside it.
export object Glfw {}

Glfw implements Move
Glfw implements Scoped

export fn Glfw.initialised() -> Either<Self, Error> {
	if glfwInit() == 0 {
		throw WindowError.INIT_FAILED
	}

	return Ok(Self {})
}

export fn Glfw.release(self) {
	glfwTerminate()
}

@error
export enum WindowError {
	INIT_FAILED,
	CREATE_FAILED { width int, height int },
	NO_MONITOR,
}

// Owned. `Move` is a conclusion: the field's type is `GLFWwindow`, which is
// declared `Move` at the boundary, and field-wise `Copy` forces the rest.
// Nothing in this file declares anything about duplication.
export object Window {
	const handle GLFWwindow,
	const title  string,
}

Window implements Move

// Borrowed. `Copy` is *also* a conclusion — `GLFWmonitor` is declared `Copy`
// at the boundary — and it is the right answer: this program never releases a
// monitor, duplicating the handle is a pointer copy, and two copies have no
// operation through which either can observe the other.
//
// The pair is the demonstration. Two wrappers, one rule, opposite tiers, and
// neither one argued for in this file.
export object Monitor {
	const handle GLFWmonitor,
}

Monitor implements Copy

// Opening a window no longer initialises GLFW, which is the point of the
// token above. An earlier draft called `glfwInit` here, so opening two
// windows initialised GLFW twice and the type system had no opinion about it.
//
// GAP — nothing *requires* a `Glfw` to exist before this is called. The token
// makes the lifetime expressible and does not make it mandatory; a parameter
// (`Window.open(glfw &Glfw, ...)`) would, at the cost of threading it through
// every call. Which of those is right is the same question as whether a
// capability should be a parameter or an ambient fact, and nothing in the
// design has had to answer it yet.
export fn Window.open(width int, height int, title string) -> Either<Self, Error> {
	// 0x00022001 is GLFW_CLIENT_API, 0 is GLFW_NO_API: tell GLFW not to make
	// an OpenGL context, because Vulkan owns the surface. Raw because the
	// constants would come from a generated binding (`vk-types.elp`).
	glfwWindowHint(0x00022001, 0)

	const name = CString.from(title)

	match glfwCreateWindow(width, height, &name, null, null) {
		// GAP — `null` twice above, for "no monitor" and "no window to share
		// with". `OpaqueHandle` is `Move`, and `null` is not a value of it.
		// `error-handling.md` makes absence `Optional<T>`, which is the right
		// elp answer and the wrong C one: an `Optional<OpaqueHandle>` is not
		// guaranteed to be a null pointer at the ABI. Nothing says how an
		// absent pointer is spelled at the boundary.
		.NULL  -> throw WindowError.CREATE_FAILED { width, height }
		handle -> return Ok(Self { handle = handle.asWindow(), title })
	}
}

export fn Window.shouldClose(&self) -> bool {
	return glfwWindowShouldClose(&self.handle) != 0
}

export fn Window.pumpEvents(&self) {
	// GAP — this must run on the thread that called `glfwInit`, and on macOS
	// specifically the main thread, because Cocoa requires it. See
	// `main.elp`: there is no way to say so.
	glfwPollEvents()
}

Window implements Scoped

// `self` by value: releasing consumes the window. Same shape as
// `SqliteBinding`'s `Connection.release`, and the same gap — `functions.md`
// has `&self` and `&var self` and no by-value receiver, which `Scoped`
// cannot be declared without.
export fn Window.release(self) {
	glfwDestroyWindow(self.handle)
}

// What is still unfixed, and it is the `Copy` row's problem rather than this
// file's: `Glfw.release` invalidates every `Monitor` in the program. Monitors
// are `Copy` — correctly, nothing releases one — so copies are scattered
// wherever anyone put them, and reverse-order release says nothing about
// values that were never bound by a `with` at all.
//
// So scoped release orders *resources* and cannot reach *borrowed handles
// derived from them*, which is `aliasing.md`'s validity gap seen from the
// release side rather than the duplication side.

export fn Monitor.primary() -> Either<Self, Error> {
	match glfwGetPrimaryMonitor() {
		.NULL  -> throw WindowError.NO_MONITOR
		handle -> return Ok(Self { handle = handle.asMonitor() })
	}
}

// vim: ft=kotlin
