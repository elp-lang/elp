// The feed screen. Two things in here are findings rather than code, and both
// predate every decision this file has now been migrated onto.

import { Screen } from elp.app
import { Column, Row } from elp.layout
import { Text, Loading } from elp.components

import { getFeed } from .internal.api
import { Composer } from .components.composer
import { FeedItem } from .components.feeditem
import { Post } from .types.post
import { screen, errorRow } from .styles

@Screen
export component Feed() {
	var posts [Post] = []
	var loading = true
	var refreshing = false

	// MIGRATED — was `var err Error`, a bare interface-typed variable assigned
	// `nil`. An interface type is not nilable; absence is `Optional<T>`.
	var err Optional<string> = nil

	// `getFeed()` yields, so `loading = true` and `loading = false` land in
	// different turns and two refreshes can be in flight at once — the first
	// to return would clear the spinner while the second is still fetching.
	//
	// `loading` cannot be the guard: it starts `true` to mean "nothing
	// fetched yet", so testing it would refuse the very first load. Display
	// state and a concurrency guard are genuinely two different things, and
	// conflating them was the original bug. `refreshing` is the guard, and it
	// works because the test and the write are adjacent with no call between
	// them (`reactivity.md`, "A yield point ends the turn").
	fn loadFeed() {
		if refreshing {
			return
		}

		refreshing = true
		defer { refreshing = false }

		loading = true

		return match getFeed() {
			Ok(fetched) -> {
				loading = false
				posts = fetched
			}
			Err(apiErr) -> {
				loading = false
				err = apiErr.toString()
			}
		}
	}

	// The body runs once at mount, on the cell thread. Calling `loadFeed()`
	// directly would block that thread for the whole fetch and settle
	// `loading` back to false before the first render, making the spinner
	// below unreachable. `effect` is the component-scoped coroutine, so a
	// blocking call belongs in one.
	effect {
		loadFeed()
	}

	// MIGRATED — `posts = posts.copy().prepend(post)`, which `aliasing.md`
	// quotes as the corpus's evidence for the `Duplicate` tier. The scan found
	// it never type-checked: `collections.md` declares a mutating method
	// returning **unit**, so `.copy().prepend(post)` is not a value.
	//
	// `posts` is a component `var`, so it is a cell, and the ratified spelling
	// is a transform. It is also strictly cheaper — no array duplicated per
	// post.
	fn handlePosted(post Post) {
		posts.update(fn (&var p) { p.prepend(post) })
	}

	return Column(lazy = true, style = screen) {
		Composer(onPosted = handlePosted)

		match err {
			nil     -> nil
			message -> Row(style = errorRow) {
				Text(message)
			}
		}

		if loading {
			Row(animationOut = .Fade) {
				Loading(spin = true)
			}
		} else {
			// MIGRATED — the markup `for` had no `by`, and identity is
			// mandatory on one. This loop is the case it is mandatory *for*:
			// `animationIn = .Fade` means a row that loses its identity
			// re-animates, and `handlePosted` prepends, so every row's index
			// shifts on every new post.
			for post in posts by post.id {
				Row(animationIn = .Fade) {
					FeedItem(post)
				}
			}
		}
	}
}

// vim: ft=kotlin
