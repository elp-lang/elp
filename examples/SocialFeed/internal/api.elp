// MIGRATED. The same set as `examples/BlogStyle/internal/api.elp`, whose
// GAP 1 through GAP 5 are the write-up: fields with no `const`/`var`,
// trailing commas in match arms, a `.new()` taking one argument where two
// were passed, and `Http.get<T>` treated as returning undecoded JSON while
// its type argument said otherwise.

import { Error, Either, From, Codec } from elp.types
import { CodeGen } from elp.macros
import { Http, HttpError, HttpBody } from elp.net
import { Post } from .types.post

@CodeGen(ToJSON, Default)
export enum ApiErrorType {
	SERVER { message string },
	USER { message string },
	@default
	UNKNOWN,
}

@CodeGen(ToJSON, Default)
export object ApiError {
	const type    ApiErrorType,
	const message string,
}

ApiError implements Error + From<HttpError>

fn ApiError.new(type ApiErrorType, message string) -> Self {
	return Self { type, message }
}

fn ApiError.toString(&self) -> string {
	return self.message
}

fn ApiError.from(value HttpError) -> Self {
	return match value.responseCode {
		400..499 -> Self.new(.USER(value.toString()), value.toString())
		500..599 -> Self.new(.SERVER(value.toString()), value.toString())
		_        -> Self.new(.UNKNOWN, "unknown transport failure")
	}
}

// Returns the most recent posts in the feed.
export fn getFeed() -> Either<[Post], Error> {
	return match Http.get<[Post]>("https://example.invalid/posts") {
		Err(err)   -> Err(ApiError.from(err))
		Ok(posts)  -> Ok(posts)
	}
}

// GAP 1 — a structural object type, and this is one of the three corpus
// instances `generics.md` lists as its open item.
//
// `object{ body string, image Optional<string> }` is a type with no name, and
// `object{ body, image = imagePath }` is a literal of one. `generics.md`
// records that the form appears three times as a type argument and that
// structural subtyping *"is its own design, not part of this one — but the
// type grammar has to admit it"*. Kept rather than rewritten, because this is
// the evidence for that item and a named request object would delete it.
//
// What a multipart request body actually wants is a reason to decide: the
// payload exists for one call, nothing else names its type, and inventing
// `CreatePostRequest` for it is the workaround a reader would resent.
export fn createPost(body string, imagePath Optional<string>) -> Either<Post, Error> {
	const payload HttpBody<object{ body string, image Optional<string> }> =
		.new(object{ body, image = imagePath }, contentType = .Multipart)

	return match Http.post<Post>("https://example.invalid/posts", payload) {
		Err(err)     -> Err(ApiError.from(err))
		Ok(created)  -> Ok(created)
	}
}

