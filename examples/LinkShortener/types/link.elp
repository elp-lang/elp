import { Either, Codec, UUID } from elp.types
import { CodeGen } from elp.macros

// MIGRATED — the corpus sweep dropped Go-style field tags from the three
// original apps and missed this file and `examples/Expenses`. Both are
// written up as `examples/BlogStyle/internal/api.elp` GAP 1 and GAP 2: a
// field default standing in for a type (`hits = 0`), and a second untyped
// metadata channel no document records.
//
// Finding them late is itself the finding. The sweep searched for the forms
// the *apps* used and these two files are libraries, which is a reminder
// that a sweep by program kind misses what a sweep by feature would not.
@CodeGen(Codec<JSON>)
export object Link {
	const code   string,
	const target string,
	var   hits   int,
}

export fn Link.new(code string, target string) -> Self {
	return Self { code, target, hits = 0 }
}

// MIGRATED, and split in two — one error type per layer
// (`error-handling.md`). `BAD_TARGET` was never a store error: it is what
// *validation* produces, before the store has been asked anything. Keeping
// the two together meant `main.elp` could not tell a rejected url from a
// code collision, and it answered both with the same status.
//
// `@error` replaces `implements Error` plus a hand-written `toString`,
// which is what the five FFI files in this corpus already did and these
// two libraries did not. `@message` is where the sentence lives now.
@error
export enum LinkError {
	@message("{url} is not an absolute http(s) url")
	BAD_TARGET { url string },
}

@error
export enum StoreError {
	@message("no link with code {code}")
	NOT_FOUND { code string },

	@message("code {code} is already in use")
	CODE_TAKEN { code string },
}

// A code is six url-safe characters derived from a fresh uuid.
export fn Link.generateCode() -> string {
	return UUID.v4().toString().replace("-", "").slice(0, 6)
}

// MIGRATED twice over, and the second change is the one with a rule
// behind it.
//
// The signature was `Either<string, Error>` — the existential — so the
// caller got a value it could only stringify. It is `LinkError` now, which
// has one variant, and `main.elp` answers it with 400 rather than with
// whatever the next arm happened to say.
//
// And `throw` is **not legal in a `.elp`**. `grammar-script-notes.md` gap
// #4 has said so since it was written: `throw` is a `.velp` ergonomic and
// script code returns an `Either` explicitly. Seven `.elp` files in this
// corpus use it at 36 sites, which is the largest single violation of a
// decided rule the sweeps have found — see `error-handling.md`, "what the
// 36 `throw` sites were really asking for".
export fn Link.validate(target string) -> Either<string, LinkError> {
	if target.startsWith("http://") || target.startsWith("https://") {
		return Ok(target)
	}

	return Err(.BAD_TARGET { url = target })
}

// vim: ft=kotlin
