import {
	Form,
	EmailInput,
	SecureTextInput,
	Button
} from elp.forms
import { error } from elp.macros
import { Text } from elp.components
// MIGRATED — `UserMessage` was imported from `.types.chat` and is not
// declared there; `User` is imported and not used either, now that the props
// are a parameter list.

// GAP 1 — how a component conforms to a props interface, which
// `interfaces.md` lists as open and this is the corpus's only instance.
//
// `LoginProps` declares the props as *methods*, because an interface is
// method-only. A component declares its props as a parameter list. Nothing
// says how the two meet: whether a component may declare a conformance at
// all, and if so whether a prop satisfies a nullary method requirement.
// Left as written, because it is the evidence.
export interface LoginProps {
	fn email() -> Optional<string>
	fn password() -> Optional<Protected<string>>
}

// This enum has the error macro which implements the Error interface.
@error
export enum LoginError {
	NO_HANDLER,
	BAD_CREDENTIALS,
	BAD_REQUEST { message string },
	SERVER_ERROR { message string },
}

// MIGRATED — `export fn LoginForm -> Component` predates the `component`
// keyword. That is the only change to this line.
//
// `export var email` is **not** the old form and stays: `grammar-script-notes
// .md`, "Params and props are different things, already decided", keeps both.
// A **param** (`component Message(from User, body string)`) is a constant
// input with no cell and no observation; a **prop** (`export var email ...`)
// is reactive and observed. This component wants the second, because a parent
// writes it and `EmailInput` writes it back.
//
// Worth stating because it was nearly migrated away during the corpus sweep:
// `examples/Expenses` writes `component EntryForm(draft Binding<string>)`,
// which looks like the same thing done differently and is not. That is a
// *constant handle* to a cell somebody else owns — the param cannot be
// rebound, the cell it points at can be written — which is the same
// distinction `examples/Sheet` draws when `Style.setBold` takes `&self` and
// not `&var self`.
export component LoginForm() {
	export var email Optional<string>

	// `*fn onSubmit(...)` would declare a *required* callback prop
	// (`functions.md`). This component deliberately handles its absence, so
	// the optionality is spelled out.
	export var onSubmit Optional<fn(string, Protected<string>)>

	// A component's own `var`s are private state, and each one lowers to a
	// cell: reads subscribe and writes patch (`reactivity.md`).
	var password Protected<string>
	var attempts = 0

	// A function declared in a block is local to it. `throw` is sugar for
	// `return Err(...)` and nothing more: it does not bubble, there is no
	// boundary catching it, and whoever calls `handleSubmit` gets an ordinary
	// `Either` to match on (`error-handling.md`).
	fn handleSubmit() {
		attempts += 1

		// `onSubmit` is a cell, so it is narrowed by *binding* rather than by
		// an `isNil()` test: a call between the test and the use would end
		// the turn and another turn could clear it (`operators.md`, "The
		// amendment: a call ends the turn").
		//
		// MIGRATED — the call was `callback(email, password)`. `aliasing.md`
		// makes `Protected<T>` **`Duplicate`, never `Copy`**, so handing the
		// secret on is an explicit `.copy()`. A second copy of a password is a
		// decision, and this is the site that makes it. `email` reads through
		// its binding and `string` is `Copy`, so it needs nothing.
		return match onSubmit {
			nil      -> throw LoginError.NO_HANDLER
			callback -> callback(email, password.copy())
		}
	}

	// A component returns something implementing `Component`, or nil.
	//
	// `&email` on a value that is already a `Binding<string>` is correct and
	// not a double-wrap: `reactivity.md` makes `&` **idempotent** in prop
	// position, and always written, because the point is visibility at the
	// use site.
	//
	// Nothing here exposes the secret, which is the honest state of this
	// file: `Protected<T>.expose()` belongs in whatever builds the login
	// request body, one call away and outside this package.
	return Form(onSubmit = handleSubmit) {
		EmailInput(&email, placeholder = "Enter your email")
		SecureTextInput(&password, placeholder = "Enter your password")

		Button(type = .FORM_SUBMIT) {
			Text("Log in")
		}
	}
}
