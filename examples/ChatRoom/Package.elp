import { Package, Version } from elp.package

// MIGRATED — `export` dropped, same as `examples/SocialFeed`. The
// `dependencies` value was also a brace-delimited map (`{ elp = "1.0.0" }`)
// where the manifest takes a list of variants (`name-resolution.md`).
@Package(
	name = "chat",
	version = .new(1, 0, 0, 0),
	entry = "main.velp",
	targets = [
		.iOS,
		.Android,
		.Web,
	],
	dependencies = [
		.stdlib("1.0.0"),
	],
)

