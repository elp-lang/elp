import { App, Window } from elp.app
import { State } from elp.app.state
import { Form, Label, Input, Button } from "elp/app/elements"
import { Message, User } from "$types/chat"
import { Message as MessageView } from "$components/message"

@State
export object ChatAppState implements Default {
	name     string,
	messages [Message],
	members  [User],
	loggedIn bool
}

fn ChatAppState.default -> Self {
	return Self(
		name = "user",
		messages = [],
		members = [],
		loggedIn = false
	)
}

@App<ChatApp>
export fn ChatApp(state &ChatAppState) -> App {
	if .name not Empty or not .loggedIn {
		for message in .messages {
			// We borrow the message to pass down which extends it's lifetime
			// and allows for mutation and avoids copying.
			MessageView(message = &message)
		}
	} else {
		Form(onSubmit={fn { self.loggedIn = true }}) {
			Label("Enter your display name") {
				Input(name = "display-name", type = "text", value = .name)
				Button {
					Text("Log in")
				}
			}
		}
	}
}

