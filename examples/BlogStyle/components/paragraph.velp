import { Component, Stylesheet } from elp.ui
import { Text } from elp.ui.components
import { FontWeight } fronm elp.app.components.Font

export fn Paragraph(text string) -> Component {
	Text(text)
}

Stylesheet {
    Text {
        .fontFamily = "Cozette Nerd Font",
        .fontWeight = FontWeight.BOLD
    }
}

