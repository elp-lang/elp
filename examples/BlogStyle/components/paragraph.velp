import {
	Component,
	Stylesheet,
	components: {
		Text,
	},
	font: {
		FontWeight, Otf
	}
} from elp.ui
import { FONT_COZETTE } from .constants

export fn Paragraph(text string) -> Component {
	Text(text)
}

Stylesheet {
    Text {
        .fontFamily = .Otf(),
        .fontWeight = FontWeight.BOLD
    }
}

