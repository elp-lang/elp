// Imports tree shake and only import the desired exports of a module.
import { OBJC, OBJC_Obj } from elp.interop
import { Error, Either, From, FromTo, Uuid } from elp.types
import { ToString, ToFrom } from elp.macros
import { Reactive } from elp.app.state
import { Http, HttpError } from elp.net

// You can call C, C++ and Objective C code by defining it as external and it's signature.
@external(.OBJC) fn OBJC_msgSend<T: OBJC_Obj + Send>(T, OBJC_Selector) -> T

// Enums take data which can be used in pattern matching.
// this enum has a to<JSON> generated for it as well, this requires thqt any unionised type present musy also implement FromTo<JSON> which string does. this will serialize to a string with the defwult enum serializer. i.e ".SERVER("some error"")"
@CodeGen(ToJSON, Default)
export enum ApiErrorType {
	SERVER(string),
	USER(string),
	@default
	UNKNOWN,
}

// An exported object with the name Content,
// objects can define their default values and types are inferred
// or just define their type. Note the assignment and type declarations.
// Also note the discrete, Go like tagged fields, these optional tokens enable safe metaprogramming and can be of any value.
// They are a build time feature similar to a @macro
@CodeGen(ToFrom<JSON>)
export object Content {
    id     = UUID.v4() `json: "id"`,

    title  string      `json: "title"`,
    body   string      `json: "body"`,
	calls  = 0,
}

// Objects can implement multiple interfaces. Interfaces don't influence the runtime,
// they are a compile time and static analysis tool. Note the generics syntax here which
// specializes the Interface to a type. You could implement From<Error>, From<int8>, From<string>, etc
// also note the macro @ToJSON, this is another build time feature, this macro generates the same code as the tagged object above.
@CodeGen(ToJSON, Default)
export object ApiError implements Error, From<HttpError> {
	type ApiErrorType
	message string
}

// Note this function implementation doesn't take a self making it a static method.
fn ApiError.new(type ApiErrorType) -> Self {
	return Self { type }
}

// Define methods on the object. self here denotes that it is an instance method,
// the .toString method is a requirement of the Error interface. Note that you can't create nested functions and instead should consider redesigning your API or using composition techniques.
fn ApiError.toString(&self) -> string {
    return self.message
}

// This method is a static method as it doesn't take a self parameter.
fn ApiError.from(err HttpError) -> Self {
	return match err.responseCode {
		400..499 -> .USER(err.toString()),
		500..599 -> .SERVER(err.toString()),
		.. -> .new(.UNKNOWN),
	}
}

// This function returns an Either<Content, Error>. Because there are two potential Error implementations in the return tree we just say this can return an Error, and at the call site we can match on its type to work out whether it was an ApiError or a SerializationError.
export fn getBlogPost(id string) -> Either<Content, Error> {
    return match Http.get<Content>("https://jsonplaceholder.typicode.com/posts/{id}") {
		Err(err) -> Err(ApiError.from(err))
		Ok(postJSON) -> Ok(Content.fromJSON(postJSON))
	}
}

export fn createBlogPost(title string, body string) -> Either<Content, Error> {
	const payload HttpBody<Content> = .new(.new(
		title,
		body
	))

    return match Http.post<Content>("https://jsonplaceholder.typicode.com/posts/", { contentType = JSON, body = payload }) {
		Err(err) -> Err(ApiError.from(err))
		Ok(postJSON) -> {
			const created Content = .fromJSON(postJSON)

			return Ok(created)
		}
	}
}

// vim: ft=kotlin
