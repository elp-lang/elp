import { Column, Row, Text, Date } from elp.app.ui.elements
import { Stylesheet } from elp.app.ui.styling
import { Paragraph } from .components.paragraph
import { FontWeight } from elp.app.ui.elements.Text

const NAME = "Dave"

@Screen
export fn Home -> Component {
    return Column {
        Row(columns = 2) {
            Column {
                Text("Current date:")
            }
            Column {
                Text(Date.Now(format="ll"))
            }
        }
        Row {
            Text("hello {name}")
            Link(to = "about") {
                Text("Read about Ellipsis")
            }
        }
    }
}

Stylesheet {
    Text, Date {
        .padding = 16
    }

    Text {
        .fontWeight = .SEMIBOLD
    }

    Date {
        .fontWeight = .LIGHT
    }
}

