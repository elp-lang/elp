import { AsyncQueue, String } from elp.types
import { Animations } from elp.ui.animations

import { getAboutContent } from .internal.api
import { Paragraph } from .components.paragraph

@Screen
export fn Blog -> Component {
	const posts, loading, error = getBlogContent()

    Column(lazy = true) {
        if error not None {
            Row(class = "error-row") {
                Text(error.asString())
            }
        }

		if loading {
			Row(animationOut = .Fade) {
				Loading(spin = true)
			}
		} else {
			for post in posts {
				Row(animationIn = .Fade) {
					Text(post.title, class="title")
					Paragraph(post.excerpt)
				}
			}
		}
    }
}

