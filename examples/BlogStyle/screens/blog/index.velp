import { AsyncQueue, String } from "elp"
import { getAboutContent } from "$app/internal/api"
import { Paragraph } from "$components/paragraph"

@Screen
export fn Blog() -> Component {
	// types are inferred by the right hand side.
	const posts, loading, error = getBlogContent()

    Column(lazy = true) {
        if error not None {
            Row(class = "error-row") {
                Text(error.asString())
            }
        }

		if loading {
			Row(animateOut = true) {
				Loading(spin = true)
			}
		} else {
			for post in posts {
				Row(animateIn = true) {
					Text(post.title, class="title")
					Paragraph(post.excerpt)
				}
			}
		}
    }
}

