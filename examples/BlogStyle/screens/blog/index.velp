import { Animations } from elp.ui.animations
import { Screen } from elp.app
import { Component } from elp.ui

import { getAboutContent } from .internal.api
import { Paragraph } from .components.paragraph

@Screen
export fn BlogListing -> Component {
	const posts, loading, err = getBlogContent()

	Column(lazy = true) {
		if err != nil {
			Row(class = "error-row") {
				Text(err.asString())
			}
		}

		if loading {
			Row(animationOut = .Fade) {
				Loading(spin = true)
			}
		} else {
			for post in posts {
				Row(animationIn = .Fade) {
					Text(post.title, class="title")
					Paragraph(post.excerpt)
				}
			}
		}
    }
}

