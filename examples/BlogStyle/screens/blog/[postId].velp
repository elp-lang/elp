import { Uuid } from elp.types
import { Screen } from elp.app
import { Column, Row, Text } from elp.ui

import { Paragraph } from .components.paragraph

object BlogPostParams {
    postId string
}

@Screen<BlogPostParams>
export fn BlogPost({ params }) -> Component {
	const post, err = getBlogPost(params.postId)

    Column {
        if err != nil {
            Row(class = "error-row") {
                Text(err.asString())
            }
        } else {
            Row {
                Text(post.title, class = "title")
                Paragraph(post.body)
            }
        }
    }
}

